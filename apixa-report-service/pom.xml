<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
<modelVersion>4.0.0</modelVersion>
<parent>
<groupId>com.securityanalyzer</groupId>
<artifactId>security-contract-analyzer</artifactId>
<version>0.0.1-SNAPSHOT</version>
</parent>
<artifactId>apixa-report-service</artifactId>
<name>APIXA Report Service</name>
<description>JSON/HTML/PDF report generation</description>

<dependencies>
<!--
  Step 16 renders already-produced results. No other APIXA module is a dependency: this
  service is a pure presentation/serialization layer and never calls an analysis service.
  The nested request records mirror the existing DTO field names so payloads can be
  forwarded unchanged, which is the transport convention used elsewhere in APIXA.
-->
<dependency>
<groupId>com.securityanalyzer</groupId>
<artifactId>apixa-common</artifactId>
</dependency>
<dependency>
<groupId>com.fasterxml.jackson.core</groupId>
<artifactId>jackson-databind</artifactId>
</dependency>
<!-- Pre-existing PDF library (already declared for this module); used for real, programmatic PDF output. -->
<dependency>
<groupId>com.github.librepdf</groupId>
<artifactId>openpdf</artifactId>
<version>2.0.3</version>
</dependency>
<dependency>
<groupId>org.xerial</groupId>
<artifactId>sqlite-jdbc</artifactId>
</dependency>
<dependency>
<groupId>org.hibernate.orm</groupId>
<artifactId>hibernate-community-dialects</artifactId>
</dependency>
</dependencies>

<build>
<plugins>
<!-- Root pom sets spring-boot-maven-plugin skip=true; enable it here so spring-boot:run works. -->
<plugin>
<groupId>org.springframework.boot</groupId>
<artifactId>spring-boot-maven-plugin</artifactId>
<configuration>
<skip>false</skip>
</configuration>
</plugin>
</plugins>
</build>
</project>