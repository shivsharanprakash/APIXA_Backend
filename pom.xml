<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.securityanalyzer</groupId>
	<artifactId>security-contract-analyzer</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>APIXA</name>
	<description>APIXA - Security Contract Conformance Analyzer (parent)</description>

	<modules>
		<module>apixa-common</module>
		<module>apixa-gateway</module>
		<module>apixa-project-service</module>
		<module>apixa-contract-service</module>
		<module>apixa-source-analysis-service</module>
		<module>apixa-mapping-service</module>
		<module>apixa-conformance-service</module>
		<module>apixa-evidence-service</module>
		<module>apixa-runtime-service</module>
		<module>apixa-impact-service</module>
		<module>apixa-benchmark-service</module>
		<module>apixa-report-service</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<sqlite-jdbc.version>3.50.3.0</sqlite-jdbc.version>
		<hibernate-community-dialects.version>7.1.4.Final</hibernate-community-dialects.version>
		<swagger-parser.version>2.1.40</swagger-parser.version>
		<spoon.version>11.2.1</spoon.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.securityanalyzer</groupId>
				<artifactId>apixa-common</artifactId>
				<version>0.0.1-SNAPSHOT</version>
			</dependency>
			<dependency>
				<groupId>org.xerial</groupId>
				<artifactId>sqlite-jdbc</artifactId>
				<version>${sqlite-jdbc.version}</version>
			</dependency>
			<dependency>
				<groupId>org.hibernate.orm</groupId>
				<artifactId>hibernate-community-dialects</artifactId>
				<version>${hibernate-community-dialects.version}</version>
			</dependency>
			<dependency>
				<groupId>io.swagger.parser.v3</groupId>
				<artifactId>swagger-parser</artifactId>
				<version>${swagger-parser.version}</version>
			</dependency>
			<dependency>
				<groupId>fr.inria.gforge.spoon</groupId>
				<artifactId>spoon-core</artifactId>
				<version>${spoon.version}</version>
			</dependency>
		</dependencyManagement>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<compilerArgs>
							<arg>-parameters</arg>
						</compilerArgs>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-maven-plugin</artifactId>
					<configuration>
						<skip>true</skip>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

</project>
